        "        graph[Skill.CODE_GENERATION] = SkillNode(skill=Skill.CODE_GENERATION, dependencies=[])\n",
        "        graph[Skill.FUNCTIONAL_TESTING] = SkillNode(skill=Skill.FUNCTIONAL_TESTING, dependencies=[Skill.CODE_GENERATION])\n",
