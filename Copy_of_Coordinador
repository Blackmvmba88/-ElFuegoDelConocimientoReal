      "source": [
        "import random\n",
        "import logging\n",
        "import asyncio\n",
        "from typing import Dict, Any, List, Optional\n",
        "\n",
        "class BlackMambaCoordinator:\n",
        "    def __init__(self, requirement: str):\n",
        "        self.state = SystemState.TASK_PLANNING\n",
        "        self.age = MockAGE()\n",
        "        self.max_retries = 3\n",
        "        self.retry_counts = {skill: 0 for skill in Skill}\n",
        "        self.project_memory = ProjectState(requirement=requirement)\n",
        "\n",
        "        self.skill_catalog = {\n",
        "            Skill.ARCHITECTURAL_DESIGN: self._handle_alfa,\n",
        "            Skill.CODE_GENERATION: self._handle_delta,\n",
        "            Skill.FUNCTIONAL_TESTING: self._handle_gamma,\n",
        "            Skill.SECURITY_AUDIT: self._handle_epsilon,\n",
        "            Skill.PERFORMANCE_SIMULATION: self._handle_beta_shadow\n",
        "        }\n",
        "\n",
        "        logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n",
        "        self.logger = logging.getLogger(\"BLACKMAMBA_CORE\")\n",
        "\n",
        "    async def run_loop():\n",
        "        self.logger.info(f\"Starting Skill-Based Swarm. Requirement: {self.project_memory.requirement}\")\n",
        "\n",
        "        while self.state not in [SystemState.SUCCESS, SystemState.FAILED]:\n",
        "            self.logger.info(f\"Current State: {self.state.name}\")\n",
        "\n",
        "            if self.state == SystemState.TASK_PLANNING:\n",
        "                # Phase 1: Planner (ALFA)\n",
        "                await self._handle_alfa()\n",
        "\n",
        "            elif self.state == SystemState.SKILL_EXECUTION:\n",
        "                # Phase 2: Builder & Guardian integration\n",
        "                await self._run_builder()\n",
        "\n",
        "            elif self.state == SystemState.VERIFICATION:\n",
        "                # Placeholder for final overall system verification if needed\n",
        "                self.state = SystemState.SUCCESS\n",
        "\n",
        "            await asyncio.sleep(0.5)\n",
        "\n",
        "        if self.state == SystemState.SUCCESS:\n",
        "            self.logger.info(\"🔥 MISSION ACCOMPLISHED: Artifact is stable and verified.\")\n",
        "        else:\n",
        "            self.logger.error(\"💀 MISSION FAILED: Swarm halted. Human intervention required.\")\n",
        "\n",
        "    async def _handle_alfa(self) -> Dict[str, Any]:\n",
        "        requirement = self.project_memory.requirement\n",
        "        self.logger.info(f\"PLANNER (ALFA): Analyzing requirement: {requirement}\")\n",
        "        await asyncio.sleep(0.5)\n",
        "        trace_id = f\"TRACE_{random.randint(1000, 9999)}\"\n",
        "        self.project_memory.trace_id = trace_id\n",
        "        blueprint = {\"type\": \"blueprint\", \"trace_id\": trace_id, \"requirement\": requirement, \"design_details\": f\"Architectural design for: {requirement}\"}\n",
        "        self.project_memory.artifacts[\"blueprint\"] = blueprint\n",
        "        # Generate a dynamic plan\n",
        "        self.project_memory.plan = [Skill.CODE_GENERATION, Skill.FUNCTIONAL_TESTING, Skill.SECURITY_AUDIT, Skill.PERFORMANCE_SIMULATION]\n",
        "        self.state = SystemState.SKILL_EXECUTION\n",
        "        return {\"status\": \"success\", \"trace_id\": trace_id}\n",
        "\n",
        "    async def _run_builder(self):\n",
        "        self.logger.info(\"BUILDER: Starting execution of planned skills.\")\n",
        "        # Process skills sequentially\n",
        "        for skill in list(self.project_memory.plan):\n",
        "            if self.state == SystemState.FAILED or self.state == SystemState.TASK_PLANNING:\n",
        "                break\n",
        "\n",
        "            skill_func = self.skill_catalog.get(skill)\n",
        "            self.logger.info(f\"BUILDER: Executing {skill.name}...\")\n",
        "            result = await skill_func(self.project_memory.artifacts)\n",
        "\n",
        "            # Guardian check\n",
        "            if await self._verify_skill_output(skill, result):\n",
        "                self.project_memory.artifacts[skill.name] = result\n",
        "                self.logger.info(f\"BUILDER: {skill.name} successful.\")\n",
        "            else:\n",
        "                self._handle_failure(skill)\n",
        "                return # Exit builder to let run_loop handle backtracking or failure\n",
        "\n",
        "        if self.state == SystemState.SKILL_EXECUTION:\n",
        "            self.state = SystemState.SUCCESS\n",
        "\n",
        "    async def _verify_skill_output(self, skill: Skill, result: Dict[str, Any]) -> bool:\n",
        "        self.logger.info(f\"GUARDIAN: Verifying output for {skill.name}...\")\n",
        "        # Simulate random failure for demo backtracking\n",
        "        if random.random() < 0.15:\n",
        "            return False\n",
        "        if result.get(\"status\") != \"success\":\n",
        "            return False\n",
        "        if skill == Skill.CODE_GENERATION:\n",
        "            code_artifact = {\"code\": result.get(\"code_artifact\")}\n",
        "            return self.age.validate_semantics(code_artifact, self.project_memory.trace_id)\n",
        "        return True\n",
        "\n",
        "    def _handle_failure(self, skill: Skill):\n",
        "        self.retry_counts[skill] += 1\n",
        "        count = self.retry_counts[skill]\n",
        "        self.logger.error(f\"GUARDIAN: Failure in {skill.name}. Attempt {count}/{self.max_retries}\")\n",
        "\n",
        "        if count >= self.max_retries:\n",
        "            self.state = SystemState.FAILED\n",
        "            return\n",
        "\n",
        "        if skill in [Skill.ARCHITECTURAL_DESIGN, Skill.SECURITY_AUDIT, Skill.PERFORMANCE_SIMULATION]:\n",
        "            self.logger.warning(f\"GUARDIAN: {skill.name} indicates structural flaw. Backtracking to PLANNER.\")\n",
        "            self.state = SystemState.TASK_PLANNING\n",
        "        else:\n",
        "            self.logger.warning(f\"GUARDIAN: {skill.name} indicates implementation flaw. Retrying SKILL_EXECUTION.\")\n",
        "            self.state = SystemState.SKILL_EXECUTION\n",
        "\n",
        "    async def _handle_delta(self, input_data: Dict[str, Any]) -> Dict[str, Any]:\n",
        "        await asyncio.sleep(0.3)\n",
        "        return {\"status\": \"success\", \"code_artifact\": \"def auth(): pass\"}\n",
        "\n",
        "    async def _handle_gamma(self, input_data: Dict[str, Any]) -> Dict[str, Any]:\n",
        "        await asyncio.sleep(0.3)\n",
        "        return {\"status\": \"success\", \"test_report\": \"Passed\"}\n",
        "\n",
        "    async def _handle_epsilon(self, input_data: Dict[str, Any]) -> Dict[str, Any]:\n",
        "        await asyncio.sleep(0.3)\n",
        "        return {\"status\": \"success\", \"audit\": \"clean\"}\n",
        "\n",
        "    async def _handle_beta_shadow(self, input_data: Dict[str, Any]) -> Dict[str, Any]:\n",
        "        await asyncio.sleep(0.3)\n",
        "        return {\"status\": \"success\", \"perf\": \"ok\"}\n",
        "\n",
        "print(\"BlackMambaCoordinator run_loop and Builder/Guardian flow fully implemented.\")"
      ],
