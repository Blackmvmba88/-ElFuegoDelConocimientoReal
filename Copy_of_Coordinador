      "source": [
        "from enum import Enum\n",
        "import logging\n",
        "\n",
        "# 1. Define Signal Enum for the Interrupt System\n",
        "class Signal(Enum):\n",
        "    SIG_RETRY = \"SIG_RETRY\"       # Implementation failure: Retry current node\n",
        "    SIG_BACKTRACK = \"SIG_BACKTRACK\" # Structural failure: Revert to Planning\n",
        "    SIG_PANIC = \"SIG_PANIC\"       # Fatal failure: Halt system\n",
        "\n",
        "# 2. Update Coordinator with Interrupt Handler\n",
        "def _interrupt_handler(self, signal: Signal, node: SkillNode):\n",
        "    \"\"\"Kernel Interrupt Handler: Processes system signals to manage state and resilience.\"\"\"\n",
        "    self.logger.warning(f\"[INTERRUPT] Received {signal.name} for process: {node.skill.name}\")\n",
        "\n",
        "    self.retry_counts[node.skill] += 1\n",
        "    count = self.retry_counts[node.skill]\n",
        "\n",
        "    if count >= self.max_retries:\n",
        "        self.logger.error(f\"[PANIC] Max retries exceeded for {node.skill.name}. Triggering KERNEL_PANIC.\")\n",
        "        self.state = SystemState.FAILED\n",
        "        return\n",
        "\n",
        "    if signal == Signal.SIG_PANIC:\n",
        "        self.state = SystemState.FAILED\n",
        "    elif signal == Signal.SIG_BACKTRACK:\n",
        "        self.logger.info(\"[SIGNAL] Reverting to TASK_PLANNING (Structural Flaw).\")\n",
        "        self.state = SystemState.TASK_PLANNING\n",
        "    elif signal == Signal.SIG_RETRY:\n",
        "        self.logger.info(f\"[SIGNAL] Resetting node {node.skill.name} to READY (Implementation Flaw).\")\n",
        "        node.state = ProcessState.READY\n",
        "        self.state = SystemState.SKILL_EXECUTION\n",
        "\n",
        "# 3. Integrate into Scheduler\n",
        "async def _run_builder_with_interrupts(self):\n",
        "    \"\"\"Scheduler: Executes nodes and triggers interrupts on verification failure.\"\"\"\n",
        "    while True:\n",
        "        graph = self.project_memory.execution_graph\n",
        "        ready_nodes = [n for n in graph.values() if n.state == ProcessState.READY and all(graph[d].state == ProcessState.TERMINATED for d in n.dependencies)]\n",
        "\n",
        "        if not ready_nodes:\n",
        "            if all(n.state == ProcessState.TERMINATED for n in graph.values()):\n",
        "                self.state = SystemState.SUCCESS\n",
        "            break\n",
        "\n",
        "        for node in ready_nodes:\n",
        "            node.state = ProcessState.RUNNING\n",
        "            result = await self._syscall_invoke_skill(node)\n",
        "\n",
        "            # Verification check triggers interrupts\n",
        "            if await self._verify_skill_output(node.skill, result):\n",
        "                node.state = ProcessState.TERMINATED\n",
        "                self.project_memory.artifacts[node.skill.name] = result\n",
        "            else:\n",
        "                # Determine signal based on skill type\n",
        "                if node.skill in [Skill.SECURITY_AUDIT, Skill.PERFORMANCE_SIMULATION]:\n",
        "                    self._interrupt_handler(Signal.SIG_BACKTRACK, node)\n",
        "                else:\n",
        "                    self._interrupt_handler(Signal.SIG_RETRY, node)\n",
        "                return # Exit builder loop to let run_os_loop handle state change\n",
        "\n",
        "# Patching the coordinator\n",
