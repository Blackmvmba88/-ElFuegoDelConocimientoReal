        "def _generate_node_trace_id(self, skill: Skill) -> str:\n",
        "    \"\"\"Generates a unique node-level trace identifier.\"\"\"\n",
        "    base_id = self.project_memory.trace_id or \"UNKNOWN\"\n",
        "    return f\"{base_id}_NODE_{skill.name}\"\n",
        "\n",
        "async def _run_builder_graph_enhanced(self):\n",
        "    \"\"\"Skill Execution Engine: Topological execution with node-level tracing and mapping.\"\"\"\n",
        "    self.logger.info(\"BUILDER: Starting dependency-aware execution with enhanced tracing.\")\n",
        "\n",
        "    while self.state == SystemState.SKILL_EXECUTION:\n",
        "        incomplete_nodes = {skill: node for skill, node in self.project_memory.project_graph.items()\n",
        "                            if node.status != NodeStatus.COMPLETED}\n",
        "\n",
        "        if not incomplete_nodes:\n",
        "            self.state = SystemState.SUCCESS\n",
        "            self.logger.info(\"BUILDER: All DAG nodes completed successfully.\")\n",
        "            break\n",
        "\n",
        "        ready_skills = []\n",
        "        for skill, node in incomplete_nodes.items():\n",
        "            if node.status == NodeStatus.PENDING:\n",
        "                deps_met = all(\n",
        "                    self.project_memory.project_graph[dep].status == NodeStatus.COMPLETED\n",
        "                    for dep in node.dependencies\n",
        "                )\n",
        "                if deps_met:\n",
        "                    ready_skills.append(skill)\n",
        "\n",
        "        if not ready_skills:\n",
        "            if any(node.status == NodeStatus.FAILED for node in incomplete_nodes.values()):\n",
        "                self.state = SystemState.FAILED\n",
        "            break\n",
        "\n",
        "        for skill in ready_skills:\n",
        "            node = self.project_memory.project_graph[skill]\n",
        "            node.status = NodeStatus.EXECUTING\n",
        "\n",
        "            # 1. Generate node-level Trace ID\n",
        "            node_trace_id = self._generate_node_trace_id(skill)\n",
        "            self.logger.info(f\"BUILDER: Executing node {skill.name} (ID: {node_trace_id})\")\n",
        "\n",
        "            handler = self.skill_catalog.get(skill)\n",
        "            try:\n",
        "                # Pass artifacts (graph context) to handler\n",
        "                result = await handler(self.project_memory.artifacts)\n",
        "\n",
        "                # 2. Guardian Gate with Node Context\n",
        "                if await self._verify_skill_output(skill, result):\n",
        "                    node.status = NodeStatus.COMPLETED\n",
        "\n",
        "                    # 3. Map artifact to specific node output key\n",
        "                    artifact_key = node.output_key or skill.name\n",
        "                    self.project_memory.artifacts[artifact_key] = result\n",
        "\n",
        "                    # 4. Record in project history with node tracing\n",
        "                    self.project_memory.history.append({\n",
        "                        \"event\": \"NODE_COMPLETED\",\n",
        "                        \"skill\": skill.name,\n",
        "                        \"node_trace_id\": node_trace_id,\n",
        "                        \"status\": \"SUCCESS\"\n",
        "                    })\n",
        "                    self.logger.info(f\"BUILDER: Node {skill.name} verified and mapped to memory.\")\n",
        "                else:\n",
        "                    node.status = NodeStatus.FAILED\n",
        "                    self._handle_failure(skill)\n",
        "                    return\n",
        "            except Exception as e:\n",
        "                self.logger.exception(f\"BUILDER: Critical error in node {skill.name}: {e}\")\n",
        "                self.state = SystemState.FAILED\n",
        "                return\n",
        "\n",
        "# Update class methods\n",
        "BlackMambaCoordinator._generate_node_trace_id = _generate_node_trace_id\n",
        "BlackMambaCoordinator._run_builder = _run_builder_graph_enhanced\n",
        "print(\"BlackMambaCoordinator updated with Node-Level Tracing and Artifact Mapping.\")"
