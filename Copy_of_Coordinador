        "import asyncio\n",
        "import random\n",
        "import logging\n",
        "from typing import Dict, Any, List, Optional\n",
        "\n",
        "class BlackMambaCoordinator:\n",
        "    def __init__(self, requirement: str):\n",
        "        self.state = SystemState.TASK_PLANNING\n",
        "        self.age = MockAGE()\n",
        "        self.max_retries = 3\n",
        "        self.retry_counts = {skill: 0 for skill in Skill}\n",
        "        self.project_memory = ProjectState(requirement=requirement)\n",
        "\n",
        "        self.skill_catalog = {\n",
        "            Skill.ARCHITECTURAL_DESIGN: self._handle_alfa,\n",
        "            Skill.CODE_GENERATION: self._handle_delta,\n",
        "            Skill.FUNCTIONAL_TESTING: self._handle_gamma,\n",
        "            Skill.SECURITY_AUDIT: self._handle_epsilon,\n",
        "            Skill.PERFORMANCE_SIMULATION: self._handle_beta_shadow\n",
        "        }\n",
        "\n",
        "        logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n",
        "        self.logger = logging.getLogger(\"BLACKMAMBA_CORE\")\n",
        "\n",
        "    async def _handle_alfa(self):\n",
        "        requirement = self.project_memory.requirement\n",
        "        self.logger.info(f\"PLANNER (ALFA): Analyzing requirement: {requirement}\")\n",
        "        await asyncio.sleep(0.5)\n",
        "        trace_id = f\"TRACE_{random.randint(1000, 9999)}\"\n",
        "        self.project_memory.trace_id = trace_id\n",
        "        self.project_memory.artifacts['blueprint'] = {\n",
        "            \"type\": \"blueprint\",\n",
        "            \"trace_id\": trace_id,\n",
        "            \"requirement\": requirement,\n",
        "            \"design_details\": f\"Architectural design strategy for: {requirement}\"\n",
        "        }\n",
        "        self.project_memory.plan = [\n",
        "            Skill.CODE_GENERATION,\n",
        "            Skill.FUNCTIONAL_TESTING,\n",
        "            Skill.SECURITY_AUDIT,\n",
        "            Skill.PERFORMANCE_SIMULATION\n",
        "        ]\n",
        "        self.state = SystemState.SKILL_EXECUTION\n",
        "        self.logger.info(f\"PLANNER: Unique Trace ID {trace_id} generated. Transitioning to {self.state.name}.\")\n",
        "\n",
        "    async def _verify_skill_output(self, skill: Skill, result: Dict[str, Any]) -> bool:\n",
        "        \"\"\"Guardian Verification Gate: Validates skill status and design adherence.\"\"\"\n",
        "        self.logger.info(f\"GUARDIAN: Verifying output for {skill.name}...\")\n",
        "\n",
        "        if result.get(\"status\") != \"success\":\n",
        "            return False\n",
        "\n",
        "        if skill == Skill.CODE_GENERATION:\n",
        "            # Semantic validation using MockAGE\n",
        "            code_artifact = {\"code\": result.get(\"artifact\", \"\")}\n",
        "            return self.age.validate_semantics(code_artifact, self.project_memory.trace_id)\n",
        "\n",
        "        return True\n",
        "\n",
        "    def _handle_failure(self, skill: Skill):\n",
        "        \"\"\"Guardian Resilience Engine: Manages retries and Intelligent Backtracking.\"\"\"\n",
        "        self.retry_counts[skill] += 1\n",
        "        count = self.retry_counts[skill]\n",
        "        self.logger.error(f\"GUARDIAN: Failure in {skill.name}. Attempt {count}/{self.max_retries}\")\n",
        "\n",
        "        if count >= self.max_retries:\n",
        "            self.logger.error(f\"GUARDIAN: Max retries exceeded for {skill.name}. Halting swarm.\")\n",
        "            self.state = SystemState.FAILED\n",
        "            return\n",
        "\n",
        "        # Intelligent Backtracking Logic\n",
        "        if skill in [Skill.SECURITY_AUDIT, Skill.PERFORMANCE_SIMULATION]:\n",
        "            self.logger.warning(f\"GUARDIAN: {skill.name} failure suggests structural flaw. Backtracking to TASK_PLANNING.\")\n",
        "            self.state = SystemState.TASK_PLANNING\n",
        "        else:\n",
        "            self.logger.warning(f\"GUARDIAN: {skill.name} failure suggests implementation flaw. Retrying SKILL_EXECUTION.\")\n",
        "            self.state = SystemState.SKILL_EXECUTION\n",
        "\n",
        "    async def _run_builder(self):\n",
        "        \"\"\"BUILDER: Orchestrates skill execution with immediate Guardian verification.\"\"\"\n",
        "        self.logger.info(\"BUILDER: Starting execution of planned skills.\")\n",
        "\n",
        "        for skill in list(self.project_memory.plan):\n",
        "            if self.state != SystemState.SKILL_EXECUTION:\n",
        "                break\n",
        "\n",
        "            self.logger.info(f\"BUILDER: Invoking handler for {skill.name}...\")\n",
        "            handler = self.skill_catalog.get(skill)\n",
        "            result = await handler(self.project_memory.artifacts)\n",
        "\n",
        "            # Immediate Guardian Verification\n",
        "            if await self._verify_skill_output(skill, result):\n",
        "                self.project_memory.artifacts[skill.name] = result\n",
        "                self.logger.info(f\"BUILDER: Skill {skill.name} passed verification.\")\n",
        "            else:\n",
        "                self._handle_failure(skill)\n",
        "                return # Exit loop to allow run_loop to process state transition\n",
        "\n",
        "        if self.state == SystemState.SKILL_EXECUTION:\n",
        "            self.state = SystemState.SUCCESS\n",
        "            self.logger.info(\"BUILDER: Mission successful.\")\n",
        "\n",
        "    async def run_loop(self):\n",
        "        self.logger.info(f\"Starting swarm for requirement: {self.project_memory.requirement}\")\n",
        "        while self.state not in [SystemState.SUCCESS, SystemState.FAILED]:\n",
        "            if self.state == SystemState.TASK_PLANNING:\n",
        "                await self._handle_alfa()\n",
        "            elif self.state == SystemState.SKILL_EXECUTION:\n",
        "                await self._run_builder()\n",
        "            await asyncio.sleep(0.1)\n",
        "\n",
        "    async def _handle_delta(self, artifacts): return {\"status\": \"success\", \"artifact\": \"code_v1\"}\n",
        "    async def _handle_gamma(self, artifacts): return {\"status\": \"success\", \"artifact\": \"test_report\"}\n",
        "    async def _handle_epsilon(self, artifacts): return {\"status\": \"success\", \"artifact\": \"sec_audit\"}\n",
        "    async def _handle_beta_shadow(self, artifacts): return {\"status\": \"success\", \"artifact\": \"perf_metrics\"}\n",
        "\n",
        "print('BlackMambaCoordinator refined with Guardian (verification and backtracking) logic.')"
      ],
