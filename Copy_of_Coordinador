        "\n",
        "        self.project_memory.execution_graph = graph\n",
        "        self.state = SystemState.SKILL_EXECUTION\n",
        "\n",
        "    async def _run_builder(self):\n",
        "        \"\"\"Scheduler: Manages process lifecycle in the DAG.\"\"\"\n",
        "        self.logger.info(\"SCHEDULER: Dispatching processes...\")\n",
        "\n",
        "        while True:\n",
        "            graph = self.project_memory.execution_graph\n",
        "\n",
        "            # Identify nodes where all dependencies are TERMINATED\n",
        "            ready_nodes = []\n",
        "            for skill, node in graph.items():\n",
        "                if node.state == ProcessState.READY:\n",
        "                    deps_met = all(graph[dep].state == ProcessState.TERMINATED for dep in node.dependencies)\n",
        "                    if deps_met:\n",
        "                        ready_nodes.append(node)\n",
        "\n",
        "            if not ready_nodes:\n",
        "                # Check if all processes are done\n",
        "                if all(n.state == ProcessState.TERMINATED for n in graph.values()):\n",
